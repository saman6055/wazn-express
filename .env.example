# =============================================================================
# Wazn Express - Environment variables
# Copy this file to .env and fill in the values. Never commit .env to git.
# =============================================================================

# --- Required ---
# MySQL connection string (e.g. mysql://user:password@host:3306/database)
DATABASE_URL=

# Secret used to sign JWT tokens and session cookies. Use a long random string.
JWT_SECRET=

# Secret required to call the one-time migration endpoint (POST /api/run-migration).
MIGRATION_SECRET=

# --- Server ---
# Port the server listens on (default: 3500)
PORT=3500

# Node environment: development | production
NODE_ENV=development

# Comma-separated list of allowed CORS origins (e.g. http://localhost:5173,https://app.example.com)
# Leave empty to disable CORS.
ALLOWED_ORIGINS=

# --- Security ---
# JWT expiry for staff sessions (default: 24h)
# STAFF_SESSION_EXPIRY=24h
# JWT expiry for customer sessions (default: 7d)
# CUSTOMER_SESSION_EXPIRY=7d
# Bcrypt salt rounds (default: 12)
# BCRYPT_ROUNDS=12
# --- Performance ---
# Database connection pool size (default: 10)
# DB_POOL_SIZE=10

# --- Optional: Storage & email ---
# S3 bucket for file uploads (e.g. package images). Omit to disable S3.
# S3_BUCKET=

# Resend API key for sending emails (notifications, password reset). Omit to disable email.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Wazn Express <noreply@yourdomain.com>

# --- Optional: Analytics (Umami) ---
# VITE_ANALYTICS_ENDPOINT=https://your-umami-instance.com
# VITE_ANALYTICS_WEBSITE_ID=your-website-id

# --- Optional: OAuth / Forge (if used) ---
# VITE_APP_ID=
# OAUTH_SERVER_URL=
# OWNER_OPEN_ID=
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=
